[Unit]
Description=Omnis OS broker IPC peer-credential gateway
After=omnis-authorizer.service
Requires=omnis-authorizer.service

[Service]
Type=simple
User=omnis-broker-gateway
Group=omnis-synthetic-broker
RuntimeDirectory=omnis-broker-gateway
RuntimeDirectoryMode=0750
SupplementaryGroups=omnis-broker-gateway-socket
Environment=OMNIS_PEER_FRONT_SOCKET=/run/omnis-broker-gateway/authorizer.sock
Environment=OMNIS_PEER_BACK_SOCKET=/run/omnis-broker-authorizer/broker.sock
Environment=OMNIS_PEER_UID=omnis-synthetic-broker
Environment=OMNIS_PEER_GID=omnis-synthetic-broker
Environment=OMNIS_PEER_SOCKET_GID=omnis-synthetic-broker
Environment=OMNIS_PEER_ALLOWED_PATHS=/internal/broker/v1/admissions,/internal/broker/v1/submissions/begin,/internal/broker/v1/provider-events,/internal/broker/v1/recovery/list,/internal/broker/v1/recovery/claim,/internal/broker/v1/projection
ExecStart=/usr/bin/python3 /opt/omnis-os/scripts/platform/broker-peer-proxy.py
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M
TasksMax=16
LimitNOFILE=64
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
