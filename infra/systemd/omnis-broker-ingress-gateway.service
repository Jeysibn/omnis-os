[Unit]
Description=Omnis OS worker to synthetic broker peer-credential gateway
After=omnis-synthetic-broker.service
Requires=omnis-synthetic-broker.service

[Service]
Type=simple
User=omnis-broker-ingress-gateway
Group=omnis-broker-ingress-callers
RuntimeDirectory=omnis-broker-ingress
RuntimeDirectoryMode=0750
SupplementaryGroups=omnis-broker-ingress-socket
Environment=OMNIS_PEER_INJECT_BROKER_TOKEN_FILE=/etc/omnis/broker-gateway.token
Environment=OMNIS_PEER_FRONT_SOCKET=/run/omnis-broker-ingress/broker.sock
Environment=OMNIS_PEER_BACK_SOCKET=/run/omnis-synthetic-broker/broker.sock
Environment=OMNIS_PEER_UID=omnis-worker
Environment=OMNIS_PEER_GID=omnis-worker
Environment=OMNIS_PEER_SOCKET_GID=omnis-broker-ingress-callers
Environment=OMNIS_PEER_ALLOWED_PATHS=/internal/broker/v1/submit
ExecStart=/usr/bin/python3 /opt/omnis-os/scripts/platform/broker-peer-proxy.py
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M
TasksMax=16
LimitNOFILE=64
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
