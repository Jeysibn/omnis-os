[Unit]
Description=Omnis OS authenticated API
After=network.target omnis-authorizer.service
Requires=omnis-authorizer.service

[Service]
Type=simple
User=omnis-api
Group=omnis-api
SupplementaryGroups=omnis-authorizer-socket
WorkingDirectory=/opt/omnis-os/apps/api
EnvironmentFile=/etc/omnis/api.env
ExecStart=/usr/bin/node --experimental-strip-types src/server.ts
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
