{
  "name": "@omnis/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node ../../scripts/ci/verify-stage2a-exclusion.mjs --project tsconfig.json --project tsconfig.server.json && vite build && tsc -p tsconfig.server.json --noEmit false && node ../../scripts/ci/verify-stage2a-artifact.mjs dist server-dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@omnis/contracts": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
