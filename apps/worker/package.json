{
  "name": "@omnis/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --env-file=../../.env.worker src/server.ts",
    "db:migrate": "node --experimental-strip-types --env-file=../../.env.migration src/migrate.ts",
    "build": "pnpm typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/run-coordinator.test.ts src/reliable-event-stream.test.ts src/sandbox-launcher-client.test.ts src/runtime-selection.test.ts",
    "test:sandbox": "pnpm --filter @omnis/sandbox-launcher test:sandbox"
  },
  "dependencies": {
    "@omnis/db": "workspace:*",
    "@omnis/contracts": "workspace:*",
    "@omnis/policy": "workspace:*",
    "@omnis/runtime-adapters": "workspace:*",
    "fastify": "5.12.7",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  }
}
