# Copy to .env.compose and set these socket group IDs from the host groups.
# This file contains no credentials. Compose image services receive their
# separate secrets from /etc/omnis/api.env and /etc/omnis/worker.env.
OMNIS_WEB_PORT=8080
OMNIS_AUTHORIZER_SOCKET_GID=10001
OMNIS_LAUNCHER_SOCKET_GID=10002
OMNIS_API_ENV_FILE=/etc/omnis/api.env
OMNIS_WORKER_ENV_FILE=/etc/omnis/worker.env
