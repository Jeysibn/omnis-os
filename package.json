{
  "name": "omnis-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm db:migrate && pnpm --parallel --filter @omnis/worker --filter @omnis/api --filter @omnis/web dev",
    "configure:owner": "node --experimental-strip-types scripts/configure-owner.ts",
    "prepare": "node --experimental-strip-types scripts/configure-hooks.ts",
    "db:up": "docker compose --env-file .env.db-admin -f infra/compose/docker-compose.yml up -d postgres",
    "db:down": "docker compose --env-file .env.db-admin -f infra/compose/docker-compose.yml down",
    "db:roles": "node --env-file=.env.worker --env-file=.env.migration --env-file=.env.db-admin --experimental-strip-types packages/db/src/provision.ts",
    "db:migrate": "pnpm --filter @omnis/worker db:migrate",
    "sandbox:image:pull": "docker pull node@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85",
    "integration:mock": "node --experimental-strip-types tests/integration/mock-run.mjs",
    "integration:recovery": "OMNIS_RECOVERY_INTEGRATION=1 node --experimental-strip-types tests/integration/mock-run.mjs",
    "integration:legacy-upgrade": "node --experimental-strip-types tests/integration/legacy-upgrade.mjs",
    "integration:backup-restore": "node --experimental-strip-types tests/integration/backup-restore-ci.mjs",
    "db:backup": "node --env-file=.env.db-admin scripts/db-recovery/backup.mjs",
    "db:restore:verify": "node --env-file=.env.db-admin scripts/db-recovery/restore-verify.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages scripts",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.mjs\" \"infra/**/*.yml\" \"*.json\" \"*.yaml\" \"*.mjs\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.mjs\" \"infra/**/*.yml\" \"*.json\" \"*.yaml\" \"*.mjs\"",
    "test": "pnpm -r test && node --test scripts/db-recovery/*.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
