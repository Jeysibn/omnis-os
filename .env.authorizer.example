# Template only. Copy values to the private .env.authorizer file; never commit populated credentials.
OMNIS_API_AUTHORIZER_TOKEN=
OMNIS_AGENT_IDEMPOTENCY_KEY=
OMNIS_AGENT_IDEMPOTENCY_KEY_VERSION=1
OMNIS_AUTHORIZER_DB_PASSWORD=
