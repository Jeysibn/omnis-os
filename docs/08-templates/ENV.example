# Example variable names only. Not a runnable deployment manifest.
# Copy to the intended runtime configuration only after deciding the secret store.
# Omnis OS - example only. Credentials and access policies require approval.
NODE_ENV=development
APP_TIMEZONE=Asia/Manila
WEB_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://omnis:CHANGE_ME@127.0.0.1:5432/omnis_os
SESSION_SECRET=GENERATE_RANDOM_LONG_SECRET
# Do not put Claude/Codex/Hermes subscription OAuth tokens here.
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_GATEWAY_KEY_REF=HOST_SECRET_STORE_REFERENCE_ONLY
ALLOWED_PAID_API_FALLBACK=false
ALLOW_BACKGROUND_CLAUDE=false
ALLOW_BACKGROUND_CODEX=false
ALLOW_REAL_PROVIDER_TESTS=false
ENABLE_3D_DEMO=true
