# `pnpm configure:owner` creates separate private .env, .env.worker,
# .env.migration, and .env.db-admin files. Keep admin credentials out of app environments.
# API-only template; this file contains no database credentials.
OMNIS_OWNER_PASSWORD_HASH=
OMNIS_SESSION_SECRET=
OMNIS_INTERNAL_TOKEN=
OMNIS_ALLOWED_ORIGIN=http://127.0.0.1:5173
OMNIS_API_HOST=127.0.0.1
OMNIS_API_PORT=4100
OMNIS_SECURE_COOKIES=false
