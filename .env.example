# Copy to .env only after running `pnpm configure:owner`.
# The setup command creates the owner password hash and independent local secrets.
OMNIS_OWNER_PASSWORD_HASH=
OMNIS_SESSION_SECRET=
OMNIS_INTERNAL_TOKEN=
OMNIS_DB_PASSWORD=
OMNIS_ALLOWED_ORIGIN=http://127.0.0.1:5173
OMNIS_API_HOST=127.0.0.1
OMNIS_API_PORT=4100
OMNIS_WORKER_HOST=127.0.0.1
OMNIS_WORKER_PORT=4101
OMNIS_SECURE_COOKIES=false
